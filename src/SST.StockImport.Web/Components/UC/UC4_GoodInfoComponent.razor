@using SST.StockImport.Web.Services
@inject OperationExecutorService OperationService
@inject ErrorHandlingService ErrorService
@inject ILogger<UC4_GoodInfoComponent> Logger

<!-- UC4: GoodInfo 資料爬取 -->
<div class="col-md-6 col-lg-3">
    <div class="card h-100 border-info">
        <div class="card-header bg-light">
            <h6 class="mb-0">🌐 下載 GoodInfo</h6>
        </div>
        <div class="card-body text-center">
            <button class="btn btn-info btn-lg w-100 mb-2" 
                    @onclick="ExecuteGoodInfoDownload" 
                    disabled="@isExecuting">
                @if (isExecuting)
                {
                    <span class="spinner-border spinner-border-sm me-2"></span>
                    <text>執行中...</text>
                }
                else
                {
                    <text>下載 GoodInfo</text>
                }
            </button>
            
            @if (!string.IsNullOrEmpty(resultMessage))
            {
                <div class="alert alert-@GetAlertClass() p-2 small">
                    @((MarkupString)resultMessage.Replace("\n", "<br>"))
                </div>
            }
            
            @if (lastResult != null && lastResult.IsSuccess)
            {
                <div class="mt-2">
                    <small class="text-muted">
                        上次執行：@lastResult.CompletedAt.ToString("HH:mm:ss")<br>
                        @if (successfulLinks > 0 || failedLinks > 0)
                        {
                            <text>成功率：@GetSuccessRate().ToString("F1")%</text>
                        }
                    </small>
                </div>
            }

            @if (isExecuting)
            {
                <div class="mt-2">
                    <small class="text-warning">
                        ⏰ 預計 30-60 分鐘<br>
                        1800+ 網頁爬取
                    </small>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private bool isExecuting = false;
    private string resultMessage = "";
    private OperationResult? lastResult;
    private int successfulLinks = 0;
    private int failedLinks = 0;

    private async Task ExecuteGoodInfoDownload()
    {
        if (isExecuting) return;

        isExecuting = true;
        resultMessage = "";
        StateHasChanged();

        try
        {
            lastResult = await OperationService.ExecuteGoodInfoDownloadAsync();
            resultMessage = lastResult.Message;

            // 從訊息中解析成功和失敗的連結數
            ParseLinkCounts(lastResult.Message);
        }
        catch (Exception ex)
        {
            resultMessage = ErrorService.HandleException(ex, "GoodInfo 資料下載");
            lastResult = OperationResult.Failure(resultMessage);
        }
        finally
        {
            isExecuting = false;
            StateHasChanged();
        }
    }

    private void ParseLinkCounts(string message)
    {
        // 簡單的解析邏輯，從訊息中提取數字
        try
        {
            if (message.Contains("成功：") && message.Contains("失敗："))
            {
                var parts = message.Split("成功：")[1].Split(" ")[0];
                if (int.TryParse(parts, out var success))
                    successfulLinks = success;

                parts = message.Split("失敗：")[1].Split(" ")[0];
                if (int.TryParse(parts, out var failed))
                    failedLinks = failed;
            }
            else if (message.Contains("所有") && message.Contains("筆都成功"))
            {
                var parts = message.Split("所有")[1].Split("筆")[0].Trim();
                if (int.TryParse(parts, out var total))
                {
                    successfulLinks = total;
                    failedLinks = 0;
                }
            }
        }
        catch
        {
            // 解析失敗時不影響主要功能
        }
    }

    private string GetAlertClass()
    {
        if (lastResult == null) return "info";
        
        return lastResult.IsSuccess switch
        {
            true when lastResult.Message.Contains("⚠️") => "warning",
            true => "success",
            false => "danger"
        };
    }

    private double GetSuccessRate()
    {
        var total = successfulLinks + failedLinks;
        return total > 0 ? (double)successfulLinks / total * 100 : 0;
    }
}