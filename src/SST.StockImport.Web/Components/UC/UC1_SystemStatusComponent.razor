@using SST.StockImport.Web.Services
@inject SystemStatusService StatusService
@inject ILogger<UC1_SystemStatusComponent> Logger
@implements IDisposable

<!-- UC1: 系統狀態監控 -->
<div class="card">
    <div class="card-header bg-info text-white">
        <h5 class="mb-0">🎯 執行狀態</h5>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-3">
                <div class="text-center">
                    <div class="badge bg-@GetStatusBadgeClass() fs-6 p-2">
                        @if (currentStatus.IsAnyOperationRunning)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        @currentStatus.CurrentOperation
                    </div>
                    <div class="small text-muted mt-1">目前狀態</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="text-center">
                    <div class="fs-5 fw-bold text-primary" title="總處理的資料筆數">
                        @currentStatus.TotalProcessedRecords.ToString("N0")
                    </div>
                    <div class="small text-muted">總處理筆數</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="text-center">
                    <div class="fs-5 fw-bold text-success" title="成功處理的連結數量">
                        @currentStatus.SuccessfulLinks.ToString("N0")
                    </div>
                    <div class="small text-muted">成功連結</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="text-center">
                    <div class="fs-5 fw-bold text-danger" title="失敗的連結數量">
                        @currentStatus.FailedLinks.ToString("N0")
                    </div>
                    <div class="small text-muted">失敗連結</div>
                </div>
            </div>
        </div>
        
        @if (currentStatus.LastUpdated != default)
        {
            <div class="row mt-2">
                <div class="col-12">
                    <small class="text-muted">
                        最後更新：@currentStatus.LastUpdated.ToString("HH:mm:ss")
                    </small>
                </div>
            </div>
        }
        
        <!-- 成功率顯示 -->
        @if (currentStatus.SuccessfulLinks + currentStatus.FailedLinks > 0)
        {
            <div class="row mt-3">
                <div class="col-12">
                    <div class="progress" style="height: 8px;">
                        <div class="progress-bar bg-success" 
                             style="width: @GetSuccessPercentage()%"
                             title="成功率：@GetSuccessPercentage().ToString("F1")%">
                        </div>
                    </div>
                    <small class="text-muted">
                        成功率：@GetSuccessPercentage().ToString("F1")% 
                        (@currentStatus.SuccessfulLinks 成功 / @(currentStatus.SuccessfulLinks + currentStatus.FailedLinks) 總計)
                    </small>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private SystemStatus currentStatus = new SystemStatus();

    protected override void OnInitialized()
    {
        currentStatus = StatusService.GetCurrentStatus();
        StatusService.StatusUpdated += OnStatusUpdated;
    }

    private void OnStatusUpdated(SystemStatus newStatus)
    {
        currentStatus = newStatus;
        InvokeAsync(StateHasChanged);
    }

    private string GetStatusBadgeClass()
    {
        if (currentStatus.IsAnyOperationRunning)
            return "warning"; // 黃色表示執行中
            
        if (currentStatus.FailedLinks > currentStatus.SuccessfulLinks && currentStatus.FailedLinks > 0)
            return "danger"; // 紅色表示錯誤較多
            
        if (currentStatus.SuccessfulLinks > 0)
            return "success"; // 綠色表示有成功
            
        return "primary"; // 藍色表示待命
    }

    private double GetSuccessPercentage()
    {
        var total = currentStatus.SuccessfulLinks + currentStatus.FailedLinks;
        return total > 0 ? (double)currentStatus.SuccessfulLinks / total * 100 : 0;
    }

    public void Dispose()
    {
        StatusService.StatusUpdated -= OnStatusUpdated;
    }
}