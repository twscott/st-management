@page "/smart-recommendation"
@rendermode InteractiveServer
@using SST.StockImport.Core.DTOs.SmartRecommendation
@using SST.StockImport.Core.DTOs
@inject HttpClient Http
@inject ILogger<SmartRecommendation> Logger
@inject IJSRuntime JS

<PageTitle>智能推荐 - SST Stock Import</PageTitle>

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="text-primary">
                <i class="bi bi-robot"></i> 智能推荐
            </h2>
            <p class="text-muted">基于历史成功模式，每日精选优质股票</p>
        </div>
    </div>

    <!-- 操作面板 -->
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="row align-items-end">
                        <div class="col-md-2">
                            <label class="form-label">推荐日期</label>
                            <input type="date" class="form-control" @bind="SelectedDate" 
                                   max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                            <small class="text-muted">选历史日期可回测准确率</small>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">推荐数量</label>
                            <input type="number" class="form-control" @bind="TopCount" min="1" max="10" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">最小成熟度</label>
                            <input type="number" class="form-control" @bind="MinMaturityScore" min="0" max="100" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">冷却期（天）</label>
                            <div class="input-group">
                                <input type="number" class="form-control" @bind="MinCoolingDays" style="width: 50px;" />
                                <span class="input-group-text">-</span>
                                <input type="number" class="form-control" @bind="MaxCoolingDays" style="width: 50px;" />
                            </div>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">布林带宽 ≥</label>
                            <input type="number" class="form-control" @bind="MinBollingerBandwidth" min="0" step="0.5" />
                            <small class="text-muted">开口率 (%) </small>
                        </div>
                    </div>
                    <div class="row align-items-end mt-3">
                        <div class="col-md-3">
                            <label class="form-label">KD_K 范围</label>
                            <div class="input-group">
                                <input type="number" class="form-control" @bind="MinKD" min="0" max="100" />
                                <span class="input-group-text">~</span>
                                <input type="number" class="form-control" @bind="MaxKD" min="0" max="100" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">量能倍数</label>
                            <div class="input-group">
                                <input type="number" class="form-control" @bind="MinVolumeRatio" min="0" step="0.5" />
                                <span class="input-group-text">~</span>
                                <input type="number" class="form-control" @bind="MaxVolumeRatio" min="0" step="0.5" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <button class="btn btn-primary btn-lg w-100" @onclick="LoadRecommendations" disabled="@IsLoading">
                                @if (IsLoading)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                    <span>分析中...</span>
                                }
                                else
                                {
                                    <i class="bi bi-stars me-2"></i>
                                    <span>获取推荐</span>
                                }
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <strong>错误：</strong> @ErrorMessage
            <button type="button" class="btn-close" @onclick="() => ErrorMessage = null"></button>
        </div>
    }

    @if (RecommendationResult != null)
    {
        <!-- 回测统计（仅历史日期） -->
        @if (RecommendationResult.IsHistoricalBacktest && RecommendationResult.BacktestStats != null)
        {
            <div class="alert alert-success" role="alert">
                <h5 class="alert-heading"><i class="bi bi-graph-up-arrow me-2"></i>历史回测结果</h5>
                <div class="row text-center mt-3">
                    <div class="col-md-3">
                        <h3 class="text-success">@RecommendationResult.BacktestStats.SuccessRate_20.ToString("F1")%</h3>
                        <small>涨超20%成功率</small>
                        <p class="mb-0 text-muted">(@RecommendationResult.BacktestStats.SuccessCount_20/@RecommendationResult.BacktestStats.TotalRecommendations)</p>
                    </div>
                    <div class="col-md-3">
                        <h3 class="text-success">@RecommendationResult.BacktestStats.SuccessRate_30.ToString("F1")%</h3>
                        <small>涨超30%成功率</small>
                        <p class="mb-0 text-muted">(@RecommendationResult.BacktestStats.SuccessCount_30/@RecommendationResult.BacktestStats.TotalRecommendations)</p>
                    </div>
                    <div class="col-md-3">
                        <h3 class="text-primary">@RecommendationResult.BacktestStats.AverageMaxGain.ToString("F1")%</h3>
                        <small>平均最高涨幅</small>
                    </div>
                    <div class="col-md-3">
                        <h3 class="text-info">@(RecommendationResult.BacktestStats.AverageDaysToAchieve20?.ToString("F0") ?? "N/A")</h3>
                        <small>平均达标天数</small>
                    </div>
                </div>
            </div>
        }

        <!-- 统计摘要 -->
        <div class="row mb-4">
            <div class="col-md-3">
                <div class="card border-primary shadow-sm">
                    <div class="card-body text-center">
                        <h6 class="text-muted mb-2">推荐日期</h6>
                        <h4 class="text-primary mb-0">@RecommendationResult.RecommendationDate.ToString("yyyy-MM-dd")</h4>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-success shadow-sm">
                    <div class="card-body text-center">
                        <h6 class="text-muted mb-2">精选推荐</h6>
                        <h4 class="text-success mb-0">@RecommendationResult.TopRecommendations.Count 只</h4>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-info shadow-sm">
                    <div class="card-body text-center">
                        <h6 class="text-muted mb-2">候选池</h6>
                        <h4 class="text-info mb-0">@RecommendationResult.TotalCandidates 只</h4>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-warning shadow-sm">
                    <div class="card-body text-center">
                        <h6 class="text-muted mb-2">生成时间</h6>
                        <h4 class="text-warning mb-0">@RecommendationResult.GeneratedAt.ToString("HH:mm:ss")</h4>
                    </div>
                </div>
            </div>
        </div>

        <!-- 推荐结果卡片 -->
        <div class="row">
            @foreach (var stock in RecommendationResult.TopRecommendations)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100 shadow-sm @GetCardBorderClass(stock.Rank)">
                        <div class="card-header @GetCardHeaderClass(stock.Rank)">
                            <div class="d-flex justify-content-between align-items-center">
                                <h5 class="mb-0">
                                    <span class="badge @GetRankBadgeClass(stock.Rank) me-2">
                                        @GetRankLabel(stock.Rank)
                                    </span>
                                    @stock.StockCode @stock.StockName
                                </h5>
                                @if (!string.IsNullOrEmpty(stock.MarketType))
                                {
                                    <span class="badge bg-secondary ms-2">@stock.MarketType</span>
                                }
                                <span class="badge @GetConfidenceBadgeClass(stock.ConfidenceLevel)">
                                    @stock.ConfidenceLevel 度
                                </span>
                            </div>
                        </div>
                        <div class="card-body">
                            <!-- 成熟度评分 -->
                            <div class="mb-3 text-center">
                                <h3 class="text-primary mb-1">@stock.MaturityScore.ToString("F0") 分</h3>
                                <small class="text-muted">成熟度评分</small>
                                <div class="progress mt-2" style="height: 8px;">
                                    <div class="progress-bar @GetScoreProgressClass(stock.MaturityScore)" 
                                         style="width: @stock.MaturityScore%"></div>
                                </div>
                            </div>

                            <!-- 关键指标 -->
                            <div class="row text-center mb-3">
                                <div class="col-6">
                                    <small class="text-muted d-block">冷却期</small>
                                    <strong>@stock.CoolingDays 天</strong>
                                </div>
                                <div class="col-6">
                                    <small class="text-muted d-block">量能倍数</small>
                                    <strong>@stock.PeakVolumeRatio.ToString("F1")x</strong>
                                </div>
                            </div>
                            <div class="row text-center mb-3">
                                <div class="col-6">
                                    <small class="text-muted d-block">资金流向</small>
                                    <strong class="@(stock.PositiveMoneyDays > stock.NegativeMoneyDays ? "text-success" : "text-danger")">
                                        @stock.PositiveMoneyDays/@(stock.PositiveMoneyDays + stock.NegativeMoneyDays)
                                    </strong>
                                </div>
                                <div class="col-6">
                                    <small class="text-muted d-block">热点日期</small>
                                    <strong>@stock.HotspotDate.ToString("MM-dd")</strong>
                                </div>
                            </div>

                            @if (stock.RecommendationFrequency >= 2)
                            {
                                <div class="alert alert-@(stock.IsConsecutiveRecommendation ? "success" : "info") p-2 mb-3">
                                    <small>
                                        <i class="bi bi-star-fill me-1"></i>
                                        <strong>@(stock.IsConsecutiveRecommendation ? "连续" : "多次")推荐 (@(stock.RecommendationFrequency)次)</strong>
                                        @if (stock.IsConsecutiveRecommendation)
                                        {
                                            <br/><span class="text-muted">历史数据：连续推荐平均涨幅24%+</span>
                                        }
                                    </small>
                                </div>
                            }

                            <!-- 价格信息 -->
                            @if (stock.SuggestedEntryPrice.HasValue)
                            {
                                <div class="bg-light p-2 rounded mb-3">
                                    <small class="text-muted d-block">建议进场价</small>
                                    <h5 class="text-dark mb-1">@stock.SuggestedEntryPrice.Value.ToString("F2")</h5>
                                    <small class="text-success">+20%: @stock.TargetPrice_20?.ToString("F2")</small>
                                    <small class="text-success ms-2">+30%: @stock.TargetPrice_30?.ToString("F2")</small>
                                </div>
                            }

                            <!-- 推荐理由 -->
                            <div class="reasons-list">
                                <small class="text-muted d-block mb-2"><strong>推荐理由：</strong></small>
                                @foreach (var reason in stock.Reasons)
                                {
                                    <div class="reason-item mb-1">
                                        <small>@reason</small>
                                    </div>
                                }
                            </div>

                            <!-- 实际表现（仅历史日期） -->
                            @if (stock.ActualPerformance != null)
                            {
                                <div class="mt-3 pt-3 border-top">
                                    <small class="text-muted d-block mb-2"><strong>📊 实际表现：</strong></small>
                                    <div class="performance-summary @(stock.ActualPerformance.Achieved20Percent ? "bg-success" : "bg-danger") bg-opacity-10 p-2 rounded">
                                        <div class="row text-center">
                                            <div class="col-6">
                                                <strong class="@(stock.ActualPerformance.MaxGainPercent > 0 ? "text-success" : "text-danger")">
                                                    @stock.ActualPerformance.MaxGainPercent.ToString("F1")%
                                                </strong>
                                                <br/><small>最高涨幅</small>
                                            </div>
                                            <div class="col-6">
                                                <strong>@stock.ActualPerformance.DaysToMaxGain 天</strong>
                                                <br/><small>达标天数</small>
                                            </div>
                                        </div>
                                        <div class="mt-2 text-center">
                                            @if (stock.ActualPerformance.Achieved30Percent)
                                            {
                                                <span class="badge bg-success">✓ 涨超30%</span>
                                            }
                                            else if (stock.ActualPerformance.Achieved20Percent)
                                            {
                                                <span class="badge bg-success">✓ 涨超20%</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">✗ 未达标</span>
                                            }
                                            
                                            @if (stock.ActualPerformance.MinLossPercent < -5)
                                            {
                                                <span class="badge bg-warning text-dark ms-1">
                                                    最大回撤 @stock.ActualPerformance.MinLossPercent.ToString("F1")%
                                                </span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                        <div class="card-footer bg-light">
                            <div class="btn-group w-100">
                                <button class="btn btn-sm btn-outline-primary" @onclick="() => ToggleChart(stock.StockCode)">
                                    <i class="bi bi-graph-up"></i> 查看
                                </button>
                                <button class="btn btn-sm btn-outline-success" @onclick="() => ToggleStock60(stock.StockCode)">
                                    <i class="bi bi-graph-up-arrow"></i> S60
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                @* 展开的走势图 *@
                @if (SelectedStockCode == stock.StockCode)
                {
                    <div class="col-md-12 mt-3">
                        <div class="card shadow-sm">
                            <div class="card-body">
                                <h6 class="text-primary mb-3">
                                    <i class="bi bi-graph-up"></i> 股票走势图 - @stock.StockCode
                                </h6>
                                <div class="alert alert-info">
                                    <i class="bi bi-info-circle"></i> 从推荐日 @SelectedDate.ToString("yyyy-MM-dd") 开始的 60 天价格走势
                                </div>
                                <div style="height: 400px; background: #f8f9fa; border: 1px dashed #dee2e6; display: flex; align-items: center; justify-content: center;">
                                    <p class="text-muted">图表功能开发中（需要集成 Chart.js 或其他图表库）</p>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                @* 展开的 Stock60Days 数据 *@
                @if (SelectedStock60Code == stock.StockCode)
                {
                    <div class="col-md-12 mt-3">
                        <div class="card shadow-sm">
                            <div class="card-body">
                                @if (IsLoadingStock60)
                                {
                                    <div class="text-center py-4">
                                        <div class="spinner-border text-primary" role="status">
                                            <span class="visually-hidden">加载中...</span>
                                        </div>
                                        <p class="mt-2 text-muted">加载 Stock60Days 数据中...</p>
                                    </div>
                                }
                                else if (Stock60Data != null)
                                {
                                    <div class="alert alert-primary">
                                        <h6 class="mb-2">
                                            <i class="bi bi-graph-up-arrow"></i> Stock60Days 技术指标 - @Stock60Data.StockName (@Stock60Data.StockID)
                                        </h6>
                                        <small>
                                            市场: <strong>@Stock60Data.StockType</strong> | 
                                            总天数: <strong>@Stock60Data.Summary.TotalDays</strong> | 
                                            最高涨幅: <strong class="text-success">@(Stock60Data.Summary.MaxGainPercent?.ToString("F2") ?? "-")%</strong> | 
                                            最大回撤: <strong class="text-danger">@(Stock60Data.Summary.MaxLossPercent?.ToString("F2") ?? "-")%</strong> | 
                                            当前 KD_K: <strong>@(Stock60Data.Summary.CurrentKD_K?.ToString("F1") ?? "-")</strong>
                                        </small>
                                    </div>

                                    <div class="table-responsive" style="max-height: 500px; overflow-y: auto;">
                                        <table class="table table-sm table-hover table-bordered">
                                            <thead class="table-dark" style="position: sticky; top: 0; z-index: 10;">
                                                <tr>
                                                    <th>日期</th>
                                                    <th>开盘</th>
                                                    <th>收盘</th>
                                                    <th>最高</th>
                                                    <th>最低</th>
                                                    <th>涨跌%</th>
                                                    <th>成交量(张)</th>
                                                    <th>KD_K</th>
                                                    <th>KD_D</th>
                                                    <th>带宽%</th>
                                                    <th>MA5</th>
                                                    <th>MA20</th>
                                                    <th>MV5(张)</th>
                                                    <th>MV20(张)</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var day in Stock60Data.DailyData)
                                                {
                                                    <tr>
                                                        <td><small>@day.StockDate.ToString("MM/dd")</small></td>
                                                        <td>@day.OpenPrice?.ToString("F2")</td>
                                                        <td><strong>@day.EndPrice?.ToString("F2")</strong></td>
                                                        <td class="text-success">@day.HighPrice?.ToString("F2")</td>
                                                        <td class="text-danger">@day.LowPrice?.ToString("F2")</td>
                                                        <td class="@(day.DailyChangePercent >= 0 ? "text-success" : "text-danger")">
                                                            @(day.DailyChangePercent?.ToString("+0.00;-0.00;0") ?? "-")%
                                                        </td>
                                                        <td>@((day.Volume / 1000)?.ToString("F0"))</td>
                                                        <td>@day.KD_K.ToString("F1")</td>
                                                        <td>@day.KD_D.ToString("F1")</td>
                                                        <td>@day.BoolkaikouDiffRate.ToString("F1")</td>
                                                        <td>@day.MA5?.ToString("F2")</td>
                                                        <td>@day.MA20?.ToString("F2")</td>
                                                        <td>@((day.MV5 / 1000)?.ToString("F0"))</td>
                                                        <td>@((day.MV20 / 1000)?.ToString("F0"))</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>

                                    <div class="row mt-3">
                                        <div class="col-md-4">
                                            <div class="card border-info">
                                                <div class="card-body p-2">
                                                    <h6 class="text-info mb-2"><small>短期 (5日)</small></h6>
                                                    <small>
                                                        均价: <strong>@(Stock60Data.Summary.AvgPrice_5D?.ToString("F2") ?? "-")</strong><br/>
                                                        均量: <strong>@((Stock60Data.Summary.AvgVolume_5D / 1000)?.ToString("F0") ?? "-") 张</strong>
                                                    </small>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="card border-warning">
                                                <div class="card-body p-2">
                                                    <h6 class="text-warning mb-2"><small>中期 (20日)</small></h6>
                                                    <small>
                                                        均价: <strong>@(Stock60Data.Summary.AvgPrice_20D?.ToString("F2") ?? "-")</strong><br/>
                                                        均量: <strong>@((Stock60Data.Summary.AvgVolume_20D / 1000)?.ToString("F0") ?? "-") 张</strong>
                                                    </small>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="card border-success">
                                                <div class="card-body p-2">
                                                    <h6 class="text-success mb-2"><small>布林带</small></h6>
                                                    <small>
                                                        上轨: <strong>@(Stock60Data.DailyData.LastOrDefault()?.BoolUp.ToString("F2") ?? "-")</strong><br/>
                                                        中轨: <strong>@(Stock60Data.DailyData.LastOrDefault()?.BoolMid.ToString("F2") ?? "-")</strong><br/>
                                                        下轨: <strong>@(Stock60Data.DailyData.LastOrDefault()?.BoolDown.ToString("F2") ?? "-")</strong>
                                                    </small>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            }
        </div>

        <!-- 使用建议 -->
        <div class="row mt-4">
            <div class="col-12">
                <div class="card border-warning">
                    <div class="card-header bg-warning text-dark">
                        <h5 class="mb-0"><i class="bi bi-info-circle-fill me-2"></i>使用建议</h5>
                    </div>
                    <div class="card-body">
                        <ul class="mb-0">
                            <li>以上推荐基于历史成功模式，仅供参考，不构成投资建议</li>
                            <li>建议重点关注<strong>信心等级为"高"</strong>的股票</li>
                            <li>进场前请自行确认当前股价、成交量等实时指标</li>
                            <li>建议设置止损点，控制风险在可接受范围内</li>
                            <li>目标价位为参考值，实际操作应根据盘面情况灵活调整</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (!IsLoading)
    {
        <div class="text-center text-muted py-5">
            <i class="bi bi-arrow-up-circle" style="font-size: 3rem;"></i>
            <p class="mt-3">点击"获取今日推荐"按钮开始分析</p>
        </div>
    }
</div>

@code {
    private SmartRecommendationResponse? RecommendationResult;
    private bool IsLoading = false;
    private string? ErrorMessage = null;

    // 查看状态
    private string? SelectedStockCode = null;
    private string? SelectedStock60Code = null;
    private Stock60DaysResponse? Stock60Data = null;
    private bool IsLoadingStock60 = false;

    // 参数
    private int TopCount = 3;
    private int MinMaturityScore = 60;
    private int MinCoolingDays = 8;
    private int MaxCoolingDays = 30;
    private decimal MinBollingerBandwidth = 30.0m;
    private int MinKD = 30;
    private int MaxKD = 60;
    private decimal MinVolumeRatio = 10;
    private decimal MaxVolumeRatio = 50;
    private DateTime SelectedDate = DateTime.Today;

    private async Task LoadRecommendations()
    {
        IsLoading = true;
        ErrorMessage = null;
        RecommendationResult = null;

        try
        {
            // 根据选择的日期决定使用哪个 API 端点
            var dateParam = SelectedDate.ToString("yyyy-MM-dd");
            var endpoint = SelectedDate.Date == DateTime.Today.Date
                ? "today"
                : dateParam;

            var url = $"/api/SmartRecommendation/{endpoint}" +
                      $"?topCount={TopCount}" +
                      $"&minMaturityScore={MinMaturityScore}" +
                      $"&minCoolingDays={MinCoolingDays}" +
                      $"&maxCoolingDays={MaxCoolingDays}" +
                      $"&minBollingerBandwidth={MinBollingerBandwidth}" +
                      $"&minPeakVolumeRatio={MinVolumeRatio}" +
                      $"&maxPeakVolumeRatio={MaxVolumeRatio}";

            Logger.LogInformation("🔍 Fetching recommendations from: {Url}", url);

            var response = await Http.GetAsync(url);
            
            Logger.LogInformation("📡 HTTP Response Status: {StatusCode}", response.StatusCode);
            
            if (!response.IsSuccessStatusCode)
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                Logger.LogError("❌ API Error: {StatusCode} - {Content}", response.StatusCode, errorContent);
                ErrorMessage = $"API 返回错误: {response.StatusCode} - {errorContent}";
                return;
            }

            RecommendationResult = await response.Content.ReadFromJsonAsync<SmartRecommendationResponse>();

            Logger.LogInformation("✅ Received {Count} recommendations, IsBacktest={IsBacktest}", 
                RecommendationResult?.TopRecommendations.Count ?? 0,
                RecommendationResult?.IsHistoricalBacktest ?? false);

            if (RecommendationResult?.BacktestStats != null)
            {
                Logger.LogInformation("📊 Backtest Stats: Success Rate = {Rate}%", 
                    RecommendationResult.BacktestStats.SuccessRate_20);
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"加载推荐失败: {ex.Message}";
            Logger.LogError(ex, "❌ Exception while loading recommendations");
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void ToggleChart(string stockCode)
    {
        SelectedStockCode = SelectedStockCode == stockCode ? null : stockCode;
    }

    private async Task ToggleStock60(string stockCode)
    {
        if (SelectedStock60Code == stockCode)
        {
            SelectedStock60Code = null;
            Stock60Data = null;
            return;
        }

        SelectedStock60Code = stockCode;
        IsLoadingStock60 = true;
        Stock60Data = null;

        try
        {
            var url = $"/api/Stock60Days/{stockCode}/history?days=20&endDate={SelectedDate:yyyy-MM-dd}";
            Stock60Data = await Http.GetFromJsonAsync<Stock60DaysResponse>(url);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load Stock60Days data for {StockCode}", stockCode);
            await JS.InvokeVoidAsync("alert", $"加载 Stock60Days 数据失败: {ex.Message}");
            SelectedStock60Code = null;
        }
        finally
        {
            IsLoadingStock60 = false;
        }
    }

    // 样式辅助方法
    private string GetCardBorderClass(int rank) => rank switch
    {
        1 => "border-danger border-3",
        2 => "border-warning border-2",
        3 => "border-info border-2",
        _ => "border-secondary"
    };

    private string GetCardHeaderClass(int rank) => rank switch
    {
        1 => "bg-danger text-white",
        2 => "bg-warning text-dark",
        3 => "bg-info text-white",
        _ => "bg-light"
    };

    private string GetRankBadgeClass(int rank) => rank switch
    {
        1 => "bg-danger",
        2 => "bg-warning text-dark",
        3 => "bg-info",
        _ => "bg-secondary"
    };

    private string GetRankLabel(int rank) => rank switch
    {
        1 => "🥇 TOP 1",
        2 => "🥈 TOP 2",
        3 => "🥉 TOP 3",
        _ => $"#{rank}"
    };

    private string GetConfidenceBadgeClass(string level) => level switch
    {
        "高" => "bg-success",
        "中" => "bg-warning text-dark",
        "低" => "bg-secondary",
        _ => "bg-secondary"
    };

    private string GetScoreProgressClass(decimal score) => score switch
    {
        >= 85 => "bg-success",
        >= 70 => "bg-warning",
        _ => "bg-secondary"
    };
