@page "/time-machine"
@rendermode InteractiveServer
@using SST.StockImport.Core.DTOs.MaturityAnalysis
@using SST.StockImport.Core.DTOs
@inject HttpClient Http
@inject ILogger<TimeMachineAnalysis> Logger
@inject IJSRuntime JS

<PageTitle>时光机分析 - 查看历史推荐结果</PageTitle>

<div class="container-fluid mt-4">
    <h1 class="mb-4">
        <i class="bi bi-clock-history"></i> 时光机分析
    </h1>
    <p class="lead text-muted">选择历史某一天，查看系统当时会推荐什么股票，并对比后续实际表现</p>

    <!-- 分析控制面板 -->
    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0"><i class="bi bi-sliders"></i> 分析参数</h5>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-2">
                    <label class="form-label fw-bold">信号源</label>
                    <select class="form-select" @bind="SignalSource">
                        <option value="0">量能爆发</option>
                        <option value="1">大阳线(≥6%)</option>
                        <option value="2">全部信号</option>
                    </select>
                    <small class="text-muted">选择热点信号类型</small>
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-bold">分析日期</label>
                    <input type="date" class="form-control" @bind="AnalysisDate" 
                           min="@EarliestDate.ToString("yyyy-MM-dd")" 
                           max="@LatestDate.ToString("yyyy-MM-dd")" />
                    <small class="text-muted">可用: @EarliestDate.ToString("yyyy-MM-dd") ~ @LatestDate.ToString("yyyy-MM-dd")</small>
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-bold">最小成熟度</label>
                    <input type="number" class="form-control" @bind="MinMaturityScore" min="0" max="100" />
                    <small class="text-muted">0-100 分</small>
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-bold">量能倍数范围</label>
                    <div class="input-group">
                        <input type="number" class="form-control" @bind="MinVolumeRatio" min="1" />
                        <span class="input-group-text">~</span>
                        <input type="number" class="form-control" @bind="MaxVolumeRatio" min="1" />
                    </div>
                    <small class="text-muted">倍数 (x)</small>
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-bold">冷却天数</label>
                    <div class="input-group">
                        <input type="number" class="form-control" @bind="MinCoolingDays" min="1" />
                        <span class="input-group-text">~</span>
                        <input type="number" class="form-control" @bind="MaxCoolingDays" min="1" />
                    </div>
                    <small class="text-muted">天</small>
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-bold">
                        KD_K 范围
                        <button class="btn btn-link btn-sm text-decoration-none p-0 ms-1" 
                                @onclick="ApplyRecommendedKD" 
                                title="应用推荐值">
                            <i class="bi bi-arrow-clockwise"></i>
                        </button>
                    </label>
                    <div class="input-group">
                        <input type="number" class="form-control" @bind="MinKD" min="0" max="100" placeholder="最小" />
                        <span class="input-group-text">~</span>
                        <input type="number" class="form-control" @bind="MaxKD" min="0" max="100" placeholder="最大" />
                    </div>
                    <small class="text-muted">@GetKDRecommendation()</small>
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-bold">布林带宽(%)</label>
                    <input type="number" class="form-control" @bind="MinBandwidth" min="0" step="0.5" placeholder="最小%" />
                    <small class="text-muted">留空为不限制</small>
                </div>
                <div class="col-md-1">
                    <label class="form-label fw-bold">追踪天数</label>
                    <input type="number" class="form-control" @bind="TrackingDays" min="30" max="120" />
                    <small class="text-muted">后续追踪</small>
                </div>
                <div class="col-md-1 d-flex align-items-end">
                    <button class="btn btn-success w-100" @onclick="RunAnalysis" disabled="@IsLoading">
                        @if (IsLoading)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        else
                        {
                            <i class="bi bi-search"></i>
                        }
                        分析
                    </button>
                </div>
            </div>
        </div>
    </div>

    @if (AnalysisResult != null)
    {
        <!-- 统计摘要 -->
        <div class="card mb-4">
            <div class="card-header bg-dark text-white">
                <h5 class="mb-0">
                    <i class="bi bi-graph-up"></i> 分析摘要 - @AnalysisResult.AnalysisDate.ToString("yyyy-MM-dd")
                </h5>
            </div>
            <div class="card-body">
                <div class="row text-center">
                    <div class="col-md-2">
                        <div class="border rounded p-3 bg-light">
                            <h4 class="text-primary">@AnalysisResult.Statistics.TotalRecommendations</h4>
                            <small class="text-muted">总推荐</small>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="border rounded p-3 bg-success bg-opacity-10">
                            <h4 class="text-success">@AnalysisResult.Statistics.SuccessRate_20.ToString("F2")%</h4>
                            <small class="text-muted">20% 成功率</small>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="border rounded p-3 bg-success bg-opacity-25">
                            <h4 class="text-success">@AnalysisResult.Statistics.SuccessRate_30.ToString("F2")%</h4>
                            <small class="text-muted">30% 成功率</small>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="border rounded p-3 bg-light">
                            <h4 class="@GetReturnColor(AnalysisResult.Statistics.AverageReturn)">
                                @AnalysisResult.Statistics.AverageReturn.ToString("F2")%
                            </h4>
                            <small class="text-muted">平均报酬</small>
                        </div>
                    </div>
                    <div class="col-md-1">
                        <div class="border rounded p-3 bg-light">
                            <h4 class="text-info">@(AnalysisResult.Statistics.AverageDaysToAchieve?.ToString("F0") ?? "-")</h4>
                            <small class="text-muted">平均天数</small>
                        </div>
                    </div>
                    <div class="col-md-1">
                        <div class="border rounded p-3 bg-success bg-opacity-10">
                            <h4 class="text-success">@AnalysisResult.Statistics.MaxGain.ToString("F2")%</h4>
                            <small class="text-muted">最大收益</small>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="border rounded p-3 bg-danger bg-opacity-10">
                            <h4 class="text-danger">@AnalysisResult.Statistics.MaxLoss.ToString("F2")%</h4>
                            <small class="text-muted">最大亏损</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 成功案例特征分析 -->
        @if (SuccessfulCandidates.Any())
        {
            <div class="card mb-4">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0">
                        <i class="bi bi-trophy-fill"></i> 成功案例特征分析 
                        <span class="badge bg-success ms-2">找到 @SuccessfulCandidates.Count 只涨超 30% 的股票！</span>
                    </h5>
                </div>
                <div class="card-body">
                    <div class="alert alert-success mb-4">
                        <h6><i class="bi bi-lightbulb-fill"></i> 成功股票的共同特征（Sign）：</h6>
                        <div class="row mt-3">
                            <div class="col-md-3">
                                <strong>平均成熟度：</strong>
                                <span class="badge bg-info fs-6">@SuccessPatterns.AvgMaturityScore.ToString("F1") 分</span>
                            </div>
                            <div class="col-md-3">
                                <strong>最佳量能范围：</strong>
                                <span class="badge bg-info fs-6">@SuccessPatterns.VolumeRatioRange</span>
                            </div>
                            <div class="col-md-3">
                                <strong>最佳冷却期：</strong>
                                <span class="badge bg-info fs-6">@SuccessPatterns.CoolingDaysRange</span>
                            </div>
                            <div class="col-md-3">
                                <strong>平均达标天数：</strong>
                                <span class="badge bg-info fs-6">@SuccessPatterns.AvgDaysToAchieve.ToString("F0") 天</span>
                            </div>
                        </div>
                    </div>

                    <h6 class="mb-3"><i class="bi bi-star-fill text-warning"></i> 精选推荐（涨超 30%）：</h6>
                    <div class="table-responsive">
                        <table class="table table-sm table-bordered table-success">
                            <thead class="table-dark">
                                <tr>
                                    <th>排名</th>
                                    <th>股票</th>
                                    <th>成熟度</th>
                                    <th>量能</th>
                                    <th>冷却期</th>
                                    <th>建议价</th>
                                    <th>最高涨幅</th>
                                    <th>达标天数</th>
                                    <th>最终涨幅</th>
                                    <th>综合评分</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int rank = 1;
                                    foreach (var candidate in SuccessfulCandidates.OrderByDescending(c => c.MaturityScore).Take(10))
                                    {
                                        <tr>
                                            <td><strong class="text-warning">@rank</strong></td>
                                            <td><strong class="text-primary">@candidate.StockCode</strong></td>
                                            <td><span class="badge bg-info">@candidate.MaturityScore.ToString("F0")</span></td>
                                            <td>@candidate.PeakVolumeRatio.ToString("F1")x</td>
                                            <td>@candidate.DaysSinceHotspotAtAnalysis 天</td>
                                            <td>@candidate.SuggestedEntryPrice.ToString("F2")</td>
                                            <td class="text-success fw-bold">
                                                +@candidate.MaxGainPercent.ToString("F2")%
                                                @if (candidate.MaxGainDate.HasValue)
                                                {
                                                    <br/><small class="text-muted">(@candidate.MaxGainDate.Value.ToString("MM/dd"))</small>
                                                }
                                            </td>
                                            <td>@candidate.DaysToAchieve 天</td>
                                            <td class="@GetReturnColor(candidate.FinalReturnPercent ?? 0)">
                                                <strong>@((candidate.FinalReturnPercent ?? 0).ToString("F2"))%</strong>
                                            </td>
                                            <td><span class="badge bg-warning text-dark">⭐ @CalculateQualityScore(candidate).ToString("F0")</span></td>
                                        </tr>
                                        rank++;
                                    }
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="alert alert-info mt-3">
                        <strong>💡 使用建议：</strong> 
                        根据以上特征，未来选股可优先关注成熟度在 <strong>@SuccessPatterns.AvgMaturityScore.ToString("F0")</strong> 分附近、
                        量能在 <strong>@SuccessPatterns.VolumeRatioRange</strong>、
                        冷却期 <strong>@SuccessPatterns.CoolingDaysRange</strong> 的股票。
                    </div>
                </div>
            </div>
        }

        <!-- 推荐结果表格 -->
        <div class="card">
            <div class="card-header bg-secondary text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-list-check"></i> 推荐结果详情</h5>
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="showOnlySuccess" @bind="ShowOnlySuccessful">
                    <label class="form-check-label" for="showOnlySuccess">
                        仅显示成功案例（涨超 20%）
                    </label>
                </div>
            </div>
            <div class="card-body">
                @if (!AnalysisResult.Candidates.Any())
                {
                    <div class="alert alert-warning" role="alert">
                        <i class="bi bi-exclamation-triangle"></i> 该日期没有找到符合条件的推荐候选，请尝试调整筛选条件。
                    </div>
                }
                else
                {
                    var displayCandidates = ShowOnlySuccessful 
                        ? AnalysisResult.Candidates.Where(c => c.Status == ResultStatus.Success && c.MaxGainPercent >= 20).ToList()
                        : AnalysisResult.Candidates;

                    if (!displayCandidates.Any())
                    {
                        <div class="alert alert-info" role="alert">
                            <i class="bi bi-info-circle"></i> 没有符合筛选条件的股票，请关闭"仅显示成功案例"查看全部结果。
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>股票</th>
                                        <th>类型</th>
                                        <th>名称</th>
                                        <th>信号</th>
                                        <th>当前价</th>
                                        <th>涨跌幅</th>
                                        <th>成熟度</th>
                                        <th>量能</th>
                                        <th>KD</th>
                                        <th>带宽(%)</th>
                                        <th>建议价</th>
                                        <th>目标价(20%)</th>
                                        <th>实际结果</th>
                                        <th>最高涨幅</th>
                                        <th>最终报酬</th>
                                        <th>操作</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var candidate in displayCandidates.OrderByDescending(c => c.MaturityScore))
                                    {
                                    <tr class="@GetRowClass(candidate.Status)">
                                        <td>
                                            <strong class="text-primary">@candidate.StockCode</strong>
                                        </td>
                                        <td>
                                            <span class="badge bg-secondary">@candidate.StockType</span>
                                        </td>
                                        <td>
                                            <small>@candidate.StockName</small>
                                        </td>
                                        <td>
                                            <span class="badge @(candidate.SignalType == "大阳线" ? "bg-warning text-dark" : "bg-info")">
                                                @candidate.SignalType
                                            </span>
                                        </td>
                                        <td>
                                            <strong>@candidate.CurrentPrice.ToString("F2")</strong>
                                        </td>
                                        <td class="@(candidate.PriceChangePercent >= 0 ? "text-success" : "text-danger")">
                                            <strong>@candidate.PriceChangePercent.ToString("+0.00;-0.00;0.00")%</strong>
                                        </td>
                                        <td>
                                            <span class="badge bg-info">@candidate.MaturityScore.ToString("F0") 分</span>
                                        </td>
                                        <td>@candidate.PeakVolumeRatio.ToString("F1")x</td>
                                        <td>@(candidate.KD_K?.ToString("F0") ?? "-")</td>
                                        <td>@(candidate.Bandwidth?.ToString("F1") ?? "-")</td>
                                        <td>@candidate.SuggestedEntryPrice.ToString("F2")</td>
                                        <td>@candidate.TargetPrice_20.ToString("F2")</td>
                                        <td>@GetResultBadge(candidate)</td>
                                        <td class="@GetReturnColor(candidate.MaxGainPercent)">
                                            <strong>@candidate.MaxGainPercent.ToString("F2")%</strong>                                            @if (candidate.MaxGainDate.HasValue)
                                            {
                                                <br/><small class="text-muted">(@candidate.MaxGainDate.Value.ToString("MM/dd"))</small>
                                            }                                        </td>
                                        <td class="@GetReturnColor(candidate.FinalReturnPercent ?? 0)">
                                            @(candidate.FinalReturnPercent?.ToString("F2") ?? "-")%
                                        </td>
                                        <td>
                                            <div class="btn-group btn-group-sm" role="group">
                                                <button class="btn btn-outline-warning" 
                                                        @onclick="() => ToggleFuture60(candidate.StockCode)">
                                                    <i class="bi bi-arrow-right-circle"></i>
                                                    F60
                                                </button>
                                                <button class="btn btn-outline-success" 
                                                        @onclick="() => ToggleStock60(candidate.StockCode)">
                                                    <i class="bi bi-graph-up-arrow"></i>
                                                    S60
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                    @if (SelectedFuture60Code == candidate.StockCode)
                                    {
                                        <tr>
                                            <td colspan="16" class="bg-light">
                                                <div class="p-3">
                                                    <h6 class="mb-3">
                                                        <i class="bi bi-arrow-right-circle"></i> 
                                                        @candidate.StockCode 未来60天走势 (从 @AnalysisDate.ToString("yyyy-MM-dd") 往后)
                                                    </h6>
                                                    
                                                    @if (IsLoadingFuture60)
                                                    {
                                                        <div class="text-center py-4">
                                                            <div class="spinner-border text-warning" role="status">
                                                                <span class="visually-hidden">加载中...</span>
                                                            </div>
                                                            <p class="mt-2">加载未来表现数据中...</p>
                                                        </div>
                                                    }
                                                    else if (Future60Data != null)
                                                    {
                                                        <!-- 统计摘要 -->
                                                        <div class="row mb-3">
                                                            <div class="col-md-12">
                                                                <div class="alert alert-warning">
                                                                    <strong>📈 未来表现摘要</strong> - 
                                                                    股票: <strong>@Future60Data.StockName (@Future60Data.StockID)</strong> | 
                                                                    类型: <strong>@Future60Data.StockType</strong> | 
                                                                    交易日: <strong>@Future60Data.Summary.TotalTradingDays 天</strong> | 
                                                                    最高涨幅: <strong class="text-success">@Future60Data.Summary.MaxGainPercent.ToString("F2")%</strong>
                                                                    @if (Future60Data.Summary.MaxGainDate.HasValue)
                                                                    {
                                                                        <text> (@Future60Data.Summary.MaxGainDate.Value.ToString("MM/dd"))</text>
                                                                    } | 
                                                                    最终报酬: <strong class="@GetReturnColor(Future60Data.Summary.FinalReturnPercent ?? 0)">@(Future60Data.Summary.FinalReturnPercent?.ToString("F2") ?? "-")%</strong>
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <!-- 每日详细数据表格 -->
                                                        <div class="row">
                                                            <div class="col-md-12">
                                                                <div class="table-responsive" style="max-height: 500px; overflow-y: auto;">
                                                                    <table class="table table-sm table-striped table-hover">
                                                                        <thead class="table-warning sticky-top">
                                                                            <tr>
                                                                                <th>日期</th>
                                                                                <th>开盘</th>
                                                                                <th>收盘</th>
                                                                                <th>最高</th>
                                                                                <th>最低</th>
                                                                                <th>单日涨跌</th>
                                                                                <th>累计报酬</th>
                                                                                <th>成交量</th>
                                                                                <th>KD_K</th>
                                                                                <th>KD_D</th>
                                                                                <th>布林带宽</th>
                                                                            </tr>
                                                                        </thead>
                                                                        <tbody>
                                                                            @foreach (var day in Future60Data.DailyData)
                                                                            {
                                                                                <tr>
                                                                                    <td><small>@day.StockDate.ToString("yyyy-MM-dd")</small></td>
                                                                                    <td>@day.OpenPrice?.ToString("F2")</td>
                                                                                    <td><strong>@day.EndPrice?.ToString("F2")</strong></td>
                                                                                    <td class="text-success">@day.HighPrice?.ToString("F2")</td>
                                                                                    <td class="text-danger">@day.LowPrice?.ToString("F2")</td>
                                                                                    <td class="@GetReturnColor(day.DailyChangePercent ?? 0)">
                                                                                        <small>@(day.DailyChangePercent?.ToString("F2") ?? "-")%</small>
                                                                                    </td>
                                                                                    <td class="@GetReturnColor(day.BaseChangePercent ?? 0)">
                                                                                        <strong>@(day.BaseChangePercent?.ToString("F2") ?? "-")%</strong>
                                                                                    </td>
                                                                                    <td><small>@((day.Volume / 1000)?.ToString("N0")) 张</small></td>
                                                                                    <td>@day.KD_K.ToString("F2")</td>
                                                                                    <td>@day.KD_D.ToString("F2")</td>
                                                                                    <td>@day.BoolkaikouDiffRate.ToString("F2")%</td>
                                                                                </tr>
                                                                            }
                                                                        </tbody>
                                                                    </table>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="alert alert-warning">
                                                            <i class="bi bi-exclamation-triangle"></i> 未能获取未来60天数据
                                                        </div>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                    @if (SelectedStock60Code == candidate.StockCode)
                                    {
                                        <tr>
                                            <td colspan="16" class="bg-light">
                                                <div class="p-3">
                                                    <h6 class="mb-3">
                                                        <i class="bi bi-graph-up-arrow"></i> 
                                                        @candidate.StockCode Stock60Days 详细数据 (过去 20 天)
                                                    </h6>
                                                    
                                                    @if (IsLoadingStock60)
                                                    {
                                                        <div class="text-center py-4">
                                                            <div class="spinner-border text-primary" role="status">
                                                                <span class="visually-hidden">加载中...</span>
                                                            </div>
                                                            <p class="mt-2">加载 Stock60Days 数据中...</p>
                                                        </div>
                                                    }
                                                    else if (Stock60Data != null)
                                                    {
                                                        <!-- 统计摘要 -->
                                                        <div class="row mb-3">
                                                            <div class="col-md-12">
                                                                <div class="alert alert-info">
                                                                    <strong>📊 统计摘要</strong> - 
                                                                    股票: <strong>@Stock60Data.StockName (@Stock60Data.StockID)</strong> | 
                                                                    类型: <strong>@Stock60Data.StockType</strong> | 
                                                                    数据天数: <strong>@Stock60Data.Summary.TotalDays 天</strong> | 
                                                                    最高涨幅: <strong class="text-success">@(Stock60Data.Summary.MaxGainPercent?.ToString("F2") ?? "-")%</strong> | 
                                                                    最低跌幅: <strong class="text-danger">@(Stock60Data.Summary.MaxLossPercent?.ToString("F2") ?? "-")%</strong> | 
                                                                    当前 KD_K: <strong>@(Stock60Data.Summary.CurrentKD_K?.ToString("F2") ?? "-")</strong>
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <!-- 每日详细数据表格 -->
                                                        <div class="row">
                                                            <div class="col-md-12">
                                                                <div class="table-responsive" style="max-height: 500px; overflow-y: auto;">
                                                                    <table class="table table-sm table-striped table-hover">
                                                                        <thead class="table-dark sticky-top">
                                                                            <tr>
                                                                                <th>日期</th>
                                                                                <th>开盘</th>
                                                                                <th>收盘</th>
                                                                                <th>最高</th>
                                                                                <th>最低</th>
                                                                                <th>单日涨跌</th>
                                                                                <th>累计涨跌</th>
                                                                                <th>成交量</th>
                                                                                <th>KD_K</th>
                                                                                <th>KD_D</th>
                                                                                <th>布林带宽</th>
                                                                                <th>MA5</th>
                                                                                <th>MA20</th>
                                                                                <th>MV5</th>
                                                                                <th>MV20</th>
                                                                            </tr>
                                                                        </thead>
                                                                        <tbody>
                                                                            @foreach (var day in Stock60Data.DailyData.OrderByDescending(d => d.StockDate))
                                                                            {
                                                                                <tr>
