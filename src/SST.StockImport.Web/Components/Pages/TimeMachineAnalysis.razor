</div>

@code {
    private DateTime AnalysisDate = DateTime.Now.AddDays(-30);
    private int SignalSource = 1;  // 🔥 默认：大阳线（最佳回测结果）
    
    // 🔥 最佳默认值（根据 SignalSource 自动设置，可手动调整）
    private int MinMaturityScore = 65;      
    private decimal MinVolumeRatio = 10;    
    private decimal MaxVolumeRatio = 100;    
    private int MinCoolingDays = 15;        // 🔥 大阳线最佳：15-35天
    private int MaxCoolingDays = 35;        // 🔥 大阳线最佳：15-35天
    private int TrackingDays = 60;          

    private int? MinKD = 40;                // 🔥 大阳线最佳：40-85
    private int? MaxKD = 85;                // 🔥 大阳线最佳：40-85
    private decimal MinBandwidth = 0;       

    // ⭐ Strategy A 过滤参数（回测准确率 27.6%）
    private bool UseAdvancedFilters = false;  // 默认关闭，由用户手动启用

    private DateTime EarliestDate = DateTime.Now.AddMonths(-6);
    private DateTime LatestDate = DateTime.Now;

    private TimeMachineAnalysisResponse? AnalysisResult;
    private string? SelectedStock60Code;
    private Stock60DaysResponse? Stock60Data;
    private bool IsLoading = false;
    private bool IsLoadingStock60 = false;
    private bool ShowOnlySuccessful = false;

    private string? SelectedFuture60Code;
    private Future60DaysResponse? Future60Data;
    private bool IsLoadingFuture60 = false;
    private string? RecommendationMessage = null;

    // 成功案例筛选（涨超 30%）
    private List<HistoricalCandidate> SuccessfulCandidates => 
        AnalysisResult?.Candidates
            .Where(c => c.Status == ResultStatus.Success && c.MaxGainPercent >= 30)
            .ToList() ?? new List<HistoricalCandidate>();

    // 成功案例特征模式
    private (
        decimal AvgMaturityScore,
        string VolumeRatioRange,
        string CoolingDaysRange,
        decimal AvgDaysToAchieve
    ) SuccessPatterns
    {
        get
        {
            if (!SuccessfulCandidates.Any())
                return (0, "-", "-", 0);

            var avgMaturity = SuccessfulCandidates.Average(c => c.MaturityScore);
            var minVolume = SuccessfulCandidates.Min(c => c.PeakVolumeRatio);
            var maxVolume = SuccessfulCandidates.Max(c => c.PeakVolumeRatio);
            var minCooling = SuccessfulCandidates.Min(c => c.DaysSinceHotspotAtAnalysis);
            var maxCooling = SuccessfulCandidates.Max(c => c.DaysSinceHotspotAtAnalysis);
            var avgDays = (decimal)SuccessfulCandidates.Where(c => c.DaysToAchieve.HasValue)
                .Average(c => c.DaysToAchieve!.Value);

            return (
                avgMaturity,
                $"{minVolume:F1} - {maxVolume:F1}x",
                $"{minCooling} - {maxCooling} 天",
                avgDays
            );
        }
    }

    // 获取信号类型的徽章样式
    private string GetSignalBadgeClass(string signalType)
    {
        return signalType switch
        {
            "大阳线" => "bg-warning text-dark",
            "长下影线" => "bg-success",
            _ => "bg-info"  // 量能爆发默认蓝色
        };
    }

    // 计算综合质量分数（成熟度 + 涨幅 - 天数）
    private decimal CalculateQualityScore(HistoricalCandidate c)
    {
        var maturityBonus = c.MaturityScore / 100 * 40; // 最高 40 分
        var gainBonus = Math.Min(c.MaxGainPercent / 100 * 40, 40); // 最高 40 分
        var speedBonus = c.DaysToAchieve.HasValue 
            ? Math.Max(0, 20 - c.DaysToAchieve.Value / 3) // 越快越好，最高 20 分
            : 0;
        
        return maturityBonus + gainBonus + speedBonus;
    }

    protected override async Task OnInitializedAsync()
    {
        // 🔥 页面加载时自动应用当前信号源的最佳配置
        ApplySmartRecommendation();
        await LoadAvailableDateRange();
    }

    private async Task LoadAvailableDateRange()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<DateRangeResponse>("/api/TimeMachineAnalysis/available-dates");
            if (response != null)
            {
                EarliestDate = response.EarliestDate;
                LatestDate = response.LatestDate;
                
                // 设置默认分析日期为最近一个月前
                if (LatestDate > DateTime.Now.AddDays(-30))
                    AnalysisDate = DateTime.Now.AddDays(-30);
                else
                    AnalysisDate = LatestDate;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "加载可用日期范围失败");
        }
    }

    private async Task RunAnalysis()
    {
        IsLoading = true;
        StateHasChanged();

        try
        {
            var url = $"/api/TimeMachineAnalysis/analyze/{AnalysisDate:yyyy-MM-dd}" +
                      $"?minMaturityScore={MinMaturityScore}" +
                      $"&minCoolingDays={MinCoolingDays}" +
                      $"&maxCoolingDays={MaxCoolingDays}" +
                      $"&minVolumeRatio={MinVolumeRatio}" +
                      $"&maxVolumeRatio={MaxVolumeRatio}" +
                      $"&trackingDays={TrackingDays}" +
                      $"&signalSource={SignalSource}" +
                      (MinKD.HasValue ? $"&minKD={MinKD.Value}" : "") +
                      (MaxKD.HasValue ? $"&maxKD={MaxKD.Value}" : "") +
                      $"&minBandwidth={MinBandwidth}" +
                      $"&useAdvancedFilters={UseAdvancedFilters.ToString().ToLower()}" +
                      $"&minVolumeMVRatio=0.7" +  // Strategy A: Vol >= MV10 * 0.7
                      $"&minKD_D=60" +             // Strategy A: KD_D >= 60
                      $"&requirePriceAboveMA10={UseAdvancedFilters.ToString().ToLower()}";  // Strategy A: Price > MA10

            Logger.LogInformation("开始时光机分析: {Url}", url);
            AnalysisResult = await Http.GetFromJsonAsync<TimeMachineAnalysisResponse>(url);
            Logger.LogInformation("时光机分析完成: 找到 {Count} 个候选", AnalysisResult?.Candidates.Count ?? 0);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "时光机分析失败");
            await JS.InvokeVoidAsync("alert", $"分析失败: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task ToggleStock60(string stockCode)
    {
        if (SelectedStock60Code == stockCode)
        {
            SelectedStock60Code = null;
            Stock60Data = null;
            return;
        }

        SelectedStock60Code = stockCode;
        IsLoadingStock60 = true;
        Stock60Data = null;
        StateHasChanged();

        try
        {
            var endDate = AnalysisDate.ToString("yyyy-MM-dd");
            var url = $"/api/Stock60Days/{stockCode}/history?days=20&endDate={endDate}";
            Logger.LogInformation("获取 Stock60Days 数据: {Url}", url);
            
            Stock60Data = await Http.GetFromJsonAsync<Stock60DaysResponse>(url);
            Logger.LogInformation("Stock60Days 数据获取完成: {Days} 天", Stock60Data?.DailyData.Count ?? 0);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "获取 Stock60Days 数据失败");
            await JS.InvokeVoidAsync("alert", $"获取 S60 数据失败: {ex.Message}");
            SelectedStock60Code = null;
        }
        finally
        {
            IsLoadingStock60 = false;
        }
    }

    private async Task ToggleFuture60(string stockCode)
    {
        if (SelectedFuture60Code == stockCode)
        {
            SelectedFuture60Code = null;
            Future60Data = null;
            return;
        }

        SelectedFuture60Code = stockCode;
        IsLoadingFuture60 = true;
        Future60Data = null;
        StateHasChanged();

        try
        {
            var startDate = AnalysisDate.ToString("yyyy-MM-dd");
            var url = $"/api/Stock60Days/{stockCode}/future?startDate={startDate}&days=60";
            Logger.LogInformation("获取 Future60 数据: {Url}", url);
            
            Future60Data = await Http.GetFromJsonAsync<Future60DaysResponse>(url);
            Logger.LogInformation("Future60 数据获取完成: {Days} 天", Future60Data?.DailyData.Count ?? 0);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "获取 Future60 数据失败");
            await JS.InvokeVoidAsync("alert", $"获取 F60 数据失败: {ex.Message}");
            SelectedFuture60Code = null;
        }
        finally
        {
            IsLoadingFuture60 = false;
        }
    }

    private string GetRowClass(ResultStatus status) => status switch
    {
        ResultStatus.Success => "table-success",
        ResultStatus.Failed => "table-danger",
        ResultStatus.InsufficientData => "table-warning",
        _ => ""
    };

    private MarkupString GetResultBadge(HistoricalCandidate candidate)
    {
        if (candidate.Status == ResultStatus.Success)
        {
            var badgeClass = candidate.AchievedTarget >= 30 ? "bg-success" : "bg-primary";
            return new MarkupString($"<span class='badge {badgeClass}'>✅ {candidate.DaysToAchieve} 天达成 {candidate.AchievedTarget}%</span>");
        }
        else if (candidate.Status == ResultStatus.Failed)
        {
            return new MarkupString("<span class='badge bg-danger'>❌ 失败</span>");
        }
        else if (candidate.Status == ResultStatus.InsufficientData)
        {
            return new MarkupString("<span class='badge bg-warning'>⚠️ 数据不足</span>");
        }
        return new MarkupString("<span class='badge bg-secondary'>⏳ 进行中</span>");
    }

    private string GetReturnColor(decimal returnPercent)
    {
        if (returnPercent >= 20) return "text-success fw-bold";
        if (returnPercent >= 10) return "text-success";
        if (returnPercent > 0) return "text-primary";
        if (returnPercent == 0) return "text-muted";
        if (returnPercent > -10) return "text-warning";
        return "text-danger fw-bold";
    }

    private string GetKDRecommendation()
    {
        return SignalSource switch
        {
            0 => "推荐: 20-70 (量能爆发)",
            1 => "🔥 最佳: 40-85 (大阳线)",
            2 => "推荐: 20-70 (长下影线)",
            _ => "留空为不限制"
        };
    }

    private void ApplyRecommendedKD()
    {
        switch (SignalSource)
        {
            case 0:  // 量能爆发
                MinKD = 20;
                MaxKD = 70;
                break;
            case 1:  // 大阳线 - 🔥 最佳参数（回测优化）
                MinKD = 40;
                MaxKD = 85;
                break;
            case 2:  // 长下影线
                MinKD = 20;
                MaxKD = 70;
                break;
            default:
                MinKD = null;
                MaxKD = null;
                break;
        }
    }

    private string GetCoolingRecommendation()
    {
        return SignalSource switch
        {
            0 => "推荐: 5-20 (量能爆发)",
            1 => "🔥 最佳: 15-35 (大阳线)",
            2 => "推荐: 5-20 (长下影线)",
            _ => "留空为不限制"
        };
    }

    private void ApplyRecommendedCooling()
    {
        switch (SignalSource)
        {
            case 0:  // 量能爆发
                MinCoolingDays = 5;
                MaxCoolingDays = 20;
                break;
            case 1:  // 大阳线 - 🔥 最佳参数（回测优化）
                MinCoolingDays = 15;
                MaxCoolingDays = 35;
                break;
            case 2:  // 长下影线
                MinCoolingDays = 5;
                MaxCoolingDays = 20;
                break;
            default:
                MinCoolingDays = 8;
                MaxCoolingDays = 30;
                break;
        }
    }

    private void ApplySmartRecommendation()
    {
        switch (SignalSource)
        {
            case 0:  // 量能爆发（Volume Spike）
                MinMaturityScore = 60;
                MinVolumeRatio = 10;
                MaxVolumeRatio = 40;
                MinCoolingDays = 5;   // 优化！基于历史回测
                MaxCoolingDays = 20;  // 优化！缩短冷却期提升48%准确率
                MinKD = 20;
                MaxKD = 70;
                MinBandwidth = 0;  // 不限制
                RecommendationMessage = "✨ 已应用【量能爆发 + 完整多头排列】最佳配置：\n" +
                    "• KD=20-70, 冷却=5-20天, 量能=10-40倍\n" +
                    "• 均线过滤: MA5>MA10>MA20>MA60 (新增！)\n" +
                    "📊 基于2025年10月-2026年2月完整回测：\n" +
                    "• 好市场(12月): 10%+准确率 43.4% (+46%!) 平均涨幅12.81%\n" +
                    "• 差市场(1-2月): 10%+准确率 16.7% (+50%!) 平均涨幅3.95%\n" +
                    "⚠️ 注意: 候选数会减少约88%，但质量显著提升(高胜率策略)";
                break;

            case 1:  // 大阳线（Big Candle）⭐ 最佳参数（2026-02 回测优化）
                MinMaturityScore = 65;
                MinVolumeRatio = 10;  //  大阳线不使用量能过滤
                MaxVolumeRatio = 100;
                MinCoolingDays = 15;  // 🔥 最佳值：15-35天（非5-20）
                MaxCoolingDays = 35;  // 🔥 最佳值：15-35天
                MinKD = 40;           // 🔥 最佳值：40-85（非30-80）
                MaxKD = 85;           // 🔥 最佳值：40-85
                MinBandwidth = 0;  // 不限制
                UseAdvancedFilters = false;  // 默认不启用，让用户手动开启
                RecommendationMessage = "✨ 已应用【大阳线】最佳配置（回测准确率 27.6%）：\n" +
                    "• KD_K=40-85, 冷却=15-35天, 涨幅≥6%, 成交量≥1000张\n" +
                    "• 均线过滤: MA5>MA10>MA20>MA60\n" +
                    "💡 建议启用 Strategy A：Vol≥MV10*0.7 + KD_D≥60 + Price>MA10\n" +
                    "📊 基于 2025-12-08 至 2026-02-14 完整回测（90天数据）\n" +
                    "🎯 目标：20%涨幅在20天内达成";
                break;

            case 2:  // 长下影线（Long Lower Shadow）
                MinMaturityScore = 60;
                MinVolumeRatio = 10;  // 长下影线不使用量能过滤
                MaxVolumeRatio = 100;
                MinCoolingDays = 5;   // 优化！基于历史回测
                MaxCoolingDays = 20;  // 优化！缩短冷却期
                MinKD = 20;
                MaxKD = 70;
                MinBandwidth = 0;  // 不限制
                RecommendationMessage = "✨ 已应用【长下影线 + 完整多头排列】最佳配置：\n" +
                    "• KD=20-70, 冷却=5-20天\n" +
                    "• 均线过滤: MA5>MA10>MA20>MA60 (新增！)\n" +
                    "📊 基于历史回测优化，采用高胜率策略";
                break;

            case 3:  // 全部信号
                MinMaturityScore = 60;
                MinVolumeRatio = 10;
                MaxVolumeRatio = 50;
                MinCoolingDays = 10;
                MaxCoolingDays = 30;
                MinKD = 20;
                MaxKD = 80;
                MinBandwidth = 0;
                RecommendationMessage = "已应用【综合】配置：适用于所有信号类型的平衡参数";
                break;
        }

        StateHasChanged();
    }

    /// <summary>
    /// 信号源切换时自动应用对应的最佳参数
    /// </summary>
    private void OnSignalSourceChanged()
    {
        ApplySmartRecommendation();
    }

    private class DateRangeResponse
    {
        public DateTime EarliestDate { get; set; }
        public DateTime LatestDate { get; set; }
        public int TotalDays { get; set; }
    }
}
