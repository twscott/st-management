@page "/data-source-validation"
@using System.Net.Http.Json
@using SST.StockImport.Core.DTOs
@rendermode InteractiveServer

<PageTitle>资料源统计与验证</PageTitle>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0">📊 资料源统计与验证</h1>
        <button class="btn btn-primary" @onclick="LoadStatistics" disabled="@isLoading">
            @if (isLoading)
            {
                <span class="spinner-border spinner-border-sm me-2"></span>
            }
            刷新数据
        </button>
    </div>

    @if (statistics != null)
    {
        <!-- 股票支数统计 -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="card">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">📈 股票支数统计</h5>
                    </div>
                    <div class="card-body">
                        <div class="row text-center">
                            <div class="col-md-4">
                                <div class="card bg-light">
                                    <div class="card-body">
                                        <h6 class="text-muted">上市 (TSE)</h6>
                                        <h2 class="mb-0">@statistics.StockCount.TseCount</h2>
                                        <small class="text-muted">昨天: @statistics.StockCount.TseCountYesterday</small>
                                        @if (Math.Abs(statistics.StockCount.TseChangePercent) > 25)
                                        {
                                            <div class="text-danger">⚠️ @statistics.StockCount.TseChangePercent%</div>
                                        }
                                        else
                                        {
                                            <div class="text-success">✓ @statistics.StockCount.TseChangePercent%</div>
                                        }
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="card bg-light">
                                    <div class="card-body">
                                        <h6 class="text-muted">上柜 (OTC)</h6>
                                        <h2 class="mb-0">@statistics.StockCount.OtcCount</h2>
                                        <small class="text-muted">昨天: @statistics.StockCount.OtcCountYesterday</small>
                                        @if (Math.Abs(statistics.StockCount.OtcChangePercent) > 25)
                                        {
                                            <div class="text-danger">⚠️ @statistics.StockCount.OtcChangePercent%</div>
                                        }
                                        else
                                        {
                                            <div class="text-success">✓ @statistics.StockCount.OtcChangePercent%</div>
                                        }
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="card bg-light">
                                    <div class="card-body">
                                        <h6 class="text-muted">兴柜 (Emerging)</h6>
                                        <h2 class="mb-0">@statistics.StockCount.EmergingCount</h2>
                                        <small class="text-muted">昨天: @statistics.StockCount.EmergingCountYesterday</small>
                                        @if (Math.Abs(statistics.StockCount.EmergingChangePercent) > 25)
                                        {
                                            <div class="text-danger">⚠️ @statistics.StockCount.EmergingChangePercent%</div>
                                        }
                                        else
                                        {
                                            <div class="text-success">✓ @statistics.StockCount.EmergingChangePercent%</div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row mt-3">
                            <div class="col-12 text-center">
                                <h4>总计: @statistics.StockCount.TotalCount 支</h4>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 成交量和价格统计 -->
        <div class="row mb-4">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0">📉 成交量统计</h5>
                    </div>
                    <div class="card-body text-center">
                        <h2>@statistics.Volume.AverageVolume.ToString("N0") 张</h2>
                        <small class="text-muted">昨天: @statistics.Volume.AverageVolumeYesterday.ToString("N0") 张</small>
                        @if (Math.Abs(statistics.Volume.ChangePercent) > 25)
                        {
                            <div class="text-danger">⚠️ @statistics.Volume.ChangePercent%</div>
                        }
                        else
                        {
                            <div class="text-success">✓ @statistics.Volume.ChangePercent%</div>
                        }
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header bg-warning text-dark">
                        <h5 class="mb-0">💰 价格统计</h5>
                    </div>
                    <div class="card-body text-center">
                        <h2>@statistics.Price.AveragePrice.ToString("N2") 元</h2>
                        <small class="text-muted">昨天: @statistics.Price.AveragePriceYesterday.ToString("N2") 元</small>
                        @if (Math.Abs(statistics.Price.ChangePercent) > 25)
                        {
                            <div class="text-danger">⚠️ @statistics.Price.ChangePercent%</div>
                        }
                        else
                        {
                            <div class="text-success">✓ @statistics.Price.ChangePercent%</div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- 7天历史趋势 -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="card">
                    <div class="card-header bg-dark text-white">
                        <h5 class="mb-0">📅 7天历史趋势</h5>
                    </div>
                    <div class="card-body">
                        @if (statistics.History7Days.Any())
                        {
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>日期</th>
                                        <th>股票支数</th>
                                        <th>平均成交量 (张)</th>
                                        <th>平均价格 (元)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var day in statistics.History7Days)
                                    {
                                        <tr>
                                            <td>@day.Date.ToString("yyyy-MM-dd")</td>
                                            <td>@day.StockCount</td>
                                            <td>@day.AverageVolume.ToString("N0")</td>
                                            <td>@day.AveragePrice.ToString("N2")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        else
                        {
                            <p class="text-muted">暂无历史数据</p>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- 异常警告 -->
        @if (statistics.Warnings.Any())
        {
            <div class="row mb-4">
                <div class="col-12">
                    <div class="card border-danger">
                        <div class="card-header bg-danger text-white">
                            <h5 class="mb-0">⚠️ 异常警告</h5>
                        </div>
                        <div class="card-body">
                            <ul class="list-group">
                                @foreach (var warning in statistics.Warnings)
                                {
                                    <li class="list-group-item list-group-item-@(warning.Severity == "error" ? "danger" : "warning")">
                                        @warning.Message
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else if (errorMessage != null)
    {
        <div class="alert alert-danger">
            <h5>错误</h5>
            <p>@errorMessage</p>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            点击"刷新数据"按钮加载资料源统计信息
        </div>
    }
</div>

@code {
    private DataSourceStatisticsDto? statistics;
    private bool isLoading;
    private string? errorMessage;

    private HttpClient? httpClient;

    protected override void OnInitialized()
    {
        httpClient = new HttpClient();
        httpClient.BaseAddress = new Uri("http://localhost:5000");
        
        // 初始加载 - 不等待，让页面先渲染
        _ = LoadStatistics();
    }

    private async Task LoadStatistics()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            statistics = await httpClient!.GetFromJsonAsync<DataSourceStatisticsDto>("/api/import/data-source-statistics");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }
}
