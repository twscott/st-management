@page "/goodinfo-test"
@inject IHttpClientFactory HttpClientFactory
@rendermode InteractiveServer

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="h3 mb-2">🔍 GoodInfo 19 Links 測試工具</h1>
            <p class="text-muted">即時測試 GoodInfo 資料下載功能，支援單一測試與整合測試</p>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-12">
            <div class="btn-group me-3" role="group">
                <button class="btn btn-success" @onclick="TestAll" disabled="@isTesting">
                    <i class="bi bi-play-circle"></i> 執行整合測試 (18個)
                </button>
                <button class="btn btn-primary" @onclick="ResetAll">
                    <i class="bi bi-arrow-clockwise"></i> 重置
                </button>
            </div>
            @if (isTesting)
            {
                <span class="text-muted">
                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>測試進行中...
                </span>
            }
        </div>
    </div>

    @if (showProgress)
    {
        <div class="row mb-3">
            <div class="col-12">
                <div class="progress" style="height: 4px;">
                    <div class="progress-bar" role="progressbar" style="width: @(progress)%"></div>
                </div>
            </div>
        </div>
    }

    @if (showSummary)
    {
        <div class="row mb-4">
            <div class="col-12">
                <div class="alert alert-info">
                    <div class="d-flex gap-4 fw-bold">
                        <div><span class="text-success">✓ 成功: @successCount</span></div>
                        <div><span class="text-danger">✗ 失敗: @failCount</span></div>
                        <div>總計: 18</div>
                    </div>
                    @if (failedLinks.Any())
                    {
                        <div class="mt-3">
                            <div class="fw-bold text-danger mb-2">失敗的連結：</div>
                            <ul class="mb-0 text-danger">
                                @foreach (var link in failedLinks)
                                {
                                    <li>@link</li>
                                }
                            </ul>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <div class="row g-3">
        @foreach (var link in links)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card @GetCardClass(link.Id)" style="min-height: 180px;">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge bg-dark">#@link.Id</span>
                            <h6 class="card-title mb-0 flex-grow-1 ms-2">@link.Name</h6>
                        </div>
                        <p class="card-text small text-muted text-truncate" title="@link.Url">@link.Url</p>
                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <small class="@GetStatusClass(link.Id)">@GetStatusText(link.Id)</small>
                            <button class="btn btn-sm btn-primary" @onclick="() => TestSingle(link.Id)" disabled="@isTesting">
                                測試
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .card.testing {
        background-color: #fff9e6;
        border-color: #f39c12;
    }
    .card.success {
        background-color: #e8f8f5;
        border-color: #27ae60;
    }
    .card.fail {
        background-color: #fdf2f2;
        border-color: #e74c3c;
    }
    .status-testing { color: #f39c12; font-weight: 600; }
    .status-success { color: #27ae60; font-weight: 600; }
    .status-fail { color: #e74c3c; font-weight: 600; }
</style>

@code {
    private bool isTesting = false;
    private bool showProgress = false;
    private bool showSummary = false;
    private double progress = 0;
    private int successCount = 0;
    private int failCount = 0;
    private List<string> failedLinks = new();

    private Dictionary<int, string> linkStatus = new();
    private Dictionary<int, string> linkStatusText = new();

    private List<LinkInfo> links = new()
    {
        new LinkInfo { Id = 1, Name = "券資比", Url = "https://goodinfo.tw/tw2/StockList.asp?MARKET_CAT=%E7%86%B1%E9%96%80%E6%8E%92%E8%A1%8C&INDUSTRY_CAT=%E5%88%B8%E8%B3%87%E6%AF%94#txtStockListData" },
        new LinkInfo { Id = 2, Name = "周轉率", Url = "https://goodinfo.tw/tw2/StockList.asp?RPT_TIME=&MARKET_CAT=%E7%86%B1%E9%96%80%E6%8E%92%E8%A1%8C&INDUSTRY_CAT=%E7%B4%AF%E8%A8%88%E6%88%90%E4%BA%A4%E9%87%8F%E9%80%B1%E8%BD%89%E7%8E%87..." },
        new LinkInfo { Id = 3, Name = "MACD負轉正", Url = "https://goodinfo.tw/tw/StockList.asp?RPT_TIME=&MARKET_CAT=%E6%99%BA%E6%85%A7%E9%81%B8%E8%82%A1&INDUSTRY_CAT=DIF%E3%80%81MACD..." },
        new LinkInfo { Id = 4, Name = "OSC負轉正", Url = "https://goodinfo.tw/tw/StockList.asp?RPT_TIME=&MARKET_CAT=%E6%99%BA%E6%85%A7%E9%81%B8%E8%82%A1&INDUSTRY_CAT=DIF%E3%80%81MACD..." },
        new LinkInfo { Id = 5, Name = "EPS創新高", Url = "https://goodinfo.tw/tw/StockList.asp?RPT_TIME=&MARKET_CAT=%E6%99%BA%E6%85%A7%E9%81%B8%E8%82%A1&INDUSTRY_CAT=%E5%96%AE..." },
        new LinkInfo { Id = 6, Name = "投信連買", Url = "https://goodinfo.tw/tw2/StockList.asp?RPT_TIME=&MARKET_CAT=%E6%99%BA%E6%85%A7%E9%81%B8%E8%82%A1&INDUSTRY_CAT=%E6%8A%95..." },
        new LinkInfo { Id = 7, Name = "超布林上軌", Url = "https://goodinfo.tw/tw/StockList.asp?RPT_TIME=&MARKET_CAT=%E6%99%BA%E6%85%A7%E9%81%B8%E8%82%A1&INDUSTRY_CAT=%E8%82%A1..." },
        new LinkInfo { Id = 8, Name = "外資連買連賣轉折", Url = "https://goodinfo.tw/tw2/StockList.asp?RPT_TIME=&MARKET_CAT=%E6%99%BA%E6%85%A7%E9%81%B8%E8%82%A1..." },
        new LinkInfo { Id = 9, Name = "投信連買連賣轉折", Url = "https://goodinfo.tw/tw2/StockList.asp?RPT_TIME=&MARKET_CAT=%E6%99%BA%E6%85%A7%E9%81%B8%E8%82%A1..." },
        new LinkInfo { Id = 10, Name = "五年新高", Url = "https://goodinfo.tw/tw/StockList.asp?RPT_TIME=&MARKET_CAT=%E6%99%BA%E6%85%A7%E9%81%B8%E8%82%A1&INDUSTRY_CAT=%E8%82%A1..." },
        new LinkInfo { Id = 11, Name = "外資連賣", Url = "https://goodinfo.tw/tw2/StockList.asp?RPT_TIME=&MARKET_CAT=%E6%99%BA%E6%85%A7%E9%81%B8%E8%82%A1&INDUSTRY_CAT=%E5%A4%96..." },
        new LinkInfo { Id = 12, Name = "投信連賣", Url = "https://goodinfo.tw/tw2/StockList.asp?RPT_TIME=&MARKET_CAT=%E6%99%BA%E6%85%A7%E9%81%B8%E8%82%A1&INDUSTRY_CAT=%E6%8A%95..." },
        new LinkInfo { Id = 13, Name = "外資投信同步買超", Url = "https://goodinfo.tw/tw2/StockList.asp?RPT_TIME=&MARKET_CAT=%E6%99%BA%E6%85%A7%E9%81%B8%E8%82%A1..." },
        new LinkInfo { Id = 14, Name = "月季黃金", Url = "https://goodinfo.tw/tw/StockList.asp?RPT_TIME=&MARKET_CAT=%E6%99%BA%E6%85%A7%E9%81%B8%E8%82%A1&INDUSTRY_CAT=%E5%9D%87..." },
        new LinkInfo { Id = 15, Name = "季營收創高", Url = "https://goodinfo.tw/tw/StockList.asp?RPT_TIME=&MARKET_CAT=%E6%99%BA%E6%85%A7%E9%81%B8%E8%82%A1&INDUSTRY_CAT=%E5%96%AE..." },
        new LinkInfo { Id = 16, Name = "財報評分", Url = "https://goodinfo.tw/tw/StockList.asp?RPT_TIME=&MARKET_CAT=%E6%99%BA%E6%85%A7%E9%81%B8%E8%82%A1&INDUSTRY_CAT=%E5%96%AE..." },
        new LinkInfo { Id = 17, Name = "外資投信同步賣超", Url = "https://goodinfo.tw/tw2/StockList.asp?RPT_TIME=&MARKET_CAT=%E6%99%BA%E6%85%A7%E9%81%B8%E8%82%A1..." },
        new LinkInfo { Id = 18, Name = "外資連買", Url = "https://goodinfo.tw/tw2/StockList.asp?RPT_TIME=&MARKET_CAT=%E6%99%BA%E6%85%A7%E9%81%B8%E8%82%A1&INDUSTRY_CAT=%E5%A4%96..." }
    };

    protected override void OnInitialized()
    {
        ResetAll();
    }

    private async Task TestSingle(int id)
    {
        if (isTesting) return;

        linkStatus[id] = "testing";
        linkStatusText[id] = "測試中...";
        StateHasChanged();

        try
        {
            using var httpClient = HttpClientFactory.CreateClient();
            httpClient.Timeout = TimeSpan.FromMinutes(10);

            var body = JsonContent.Create(new { LinkId = id });
            var response = await httpClient.PostAsync(
                "http://localhost:5008/api/goodinfo/test/single", body);
            var result = await response.Content.ReadFromJsonAsync<SingleTestResult>();

            if (result?.Success == true)
            {
                linkStatus[id] = "success";
                linkStatusText[id] = $"✓ {result.Message} ({result.Duration}秒)";
            }
            else
            {
                linkStatus[id] = "fail";
                linkStatusText[id] = $"✗ {result?.Message ?? "測試失敗"}";
            }
        }
        catch (Exception ex)
        {
            linkStatus[id] = "fail";
            linkStatusText[id] = $"✗ 錯誤: {ex.Message}";
        }

        StateHasChanged();
    }

    private async Task TestAll()
    {
        if (isTesting) return;

        isTesting = true;
        showProgress = true;
        showSummary = false;
        progress = 0;
        ResetAll();
        StateHasChanged();

        try
        {
            using var httpClient = HttpClientFactory.CreateClient();
            httpClient.Timeout = TimeSpan.FromMinutes(30);
            
            var response = await httpClient.PostAsync("http://localhost:5008/api/goodinfo/test/all", null);
            var data = await response.Content.ReadFromJsonAsync<AllTestResult>();

            if (data?.Results != null)
            {
                int index = 0;
                foreach (var result in data.Results)
                {
                    index++;
                    linkStatus[result.Id] = result.Success ? "success" : "fail";
                    linkStatusText[result.Id] = result.Success 
                        ? $"✓ {result.Message} ({result.Duration}秒)"
                        : $"✗ {result.Message}";
                    
                    if (result.Success)
                        successCount++;
                    else
                    {
                        failCount++;
                        failedLinks.Add($"{result.Id}. {result.Name}");
                    }
                    
                    progress = ((double)index / 18) * 100;
                    StateHasChanged();
                }

                showSummary = true;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"測試失敗: {ex.Message}");
        }
        finally
        {
            isTesting = false;
            await Task.Delay(1000);
            showProgress = false;
            StateHasChanged();
        }
    }

    private void ResetAll()
    {
        linkStatus.Clear();
        linkStatusText.Clear();
        for (int i = 1; i <= 19; i++)
        {
            linkStatus[i] = "";
            linkStatusText[i] = "等待測試";
        }
        showSummary = false;
        successCount = 0;
        failCount = 0;
        failedLinks.Clear();
    }

    private string GetCardClass(int id) => linkStatus.GetValueOrDefault(id, "") switch
    {
        "testing" => "testing",
        "success" => "success",
        "fail" => "fail",
        _ => ""
    };

    private string GetStatusClass(int id) => linkStatus.GetValueOrDefault(id, "") switch
    {
        "testing" => "status-testing",
        "success" => "status-success",
        "fail" => "status-fail",
        _ => ""
    };

    private string GetStatusText(int id) => linkStatusText.GetValueOrDefault(id, "等待測試");

    private class LinkInfo
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public string Url { get; set; } = "";
    }

    private class SingleTestResult
    {
        public bool Success { get; set; }
        public int LinkId { get; set; }
        public string LinkName { get; set; } = "";
        public string Message { get; set; } = "";
        public double Duration { get; set; }
    }

    private class AllTestResult
    {
        public int TotalTests { get; set; }
        public int SuccessCount { get; set; }
        public int FailCount { get; set; }
        public double SuccessRate { get; set; }
        public double TotalDuration { get; set; }
        public List<TestResultItem> Results { get; set; } = new();
    }

    private class TestResultItem
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public bool Success { get; set; }
        public string Message { get; set; } = "";
        public double Duration { get; set; }
    }
}
