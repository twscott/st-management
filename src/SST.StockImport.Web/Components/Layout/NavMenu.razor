@using SST.StockImport.Web.Services
@inject IImportApiService ApiService
@inject ILogger<NavMenu> Logger
@inject IJSRuntime JS

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">📊 SST 股票匯入系統</a>
    </div>
</div>

<!-- Database Status Banner -->
<div class="database-status-banner @GetDatabaseBannerClass()">
    <div class="d-flex justify-content-between align-items-center px-3 py-2">
        <div class="database-info">
            @if (isLoadingDatabase)
            {
                <span class="spinner-border spinner-border-sm me-2"></span>
                <span>載入中...</span>
            }
            else if (!string.IsNullOrEmpty(currentDatabase))
            {
                <span class="database-icon">@GetDatabaseIcon()</span>
                <strong>@GetDatabaseDisplayText()</strong>
            }
            else
            {
                <span>⚠️ 無法載入資料庫資訊</span>
            }
        </div>
        
        <div class="database-switcher">
            <select class="form-select form-select-sm" 
                    @bind="selectedDatabase" 
                    @bind:after="OnDatabaseSelectionChanged"
                    disabled="@(isLoadingDatabase || isSwitching)">
                <option value="sstv2">sstv2 (開發測試)</option>
                <option value="sst">sst (正式環境 ⚠️)</option>
            </select>
        </div>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> 首頁
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="import">
                <span class="bi bi-download" aria-hidden="true"></span> 資料匯入
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="goodinfo-test">
                <span class="bi bi-check2-square" aria-hidden="true"></span> GoodInfo 測試
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="uc-schedule-management">
                <span class="bi bi-clock-history" aria-hidden="true"></span> UC日程管理
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="timer-management">
                <span class="bi bi-hourglass-split" aria-hidden="true"></span> 定时任务管理
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="time-machine">
                <span class="bi bi-clock-history" aria-hidden="true"></span> 🕰️ 时光机分析
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="smart-recommendation">
                <span class="bi bi-robot" aria-hidden="true"></span> 🤖 智能推荐（旧版）
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="daily-recommendations">
                <span class="bi bi-stars" aria-hidden="true"></span> ⭐ 每日分类推荐
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="database">
                <span class="bi bi-database" aria-hidden="true"></span> 資料庫備份還原
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="date-data-query">
                <span class="bi bi-calendar-check" aria-hidden="true"></span> 📅 日期資料查詢
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="stock60days-recalc">
                <span class="bi bi-graph-up" aria-hidden="true"></span> 📈 Stock60 重算
            </NavLink>
        </div>
    </nav>
</div>

@code {
    private string currentDatabase = "";
    private string selectedDatabase = "sstv2";
    private bool isLoadingDatabase = true;
    private bool isSwitching = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadCurrentDatabaseAsync();
    }

    private async Task LoadCurrentDatabaseAsync()
    {
        isLoadingDatabase = true;
        try
        {
            var result = await ApiService.GetCurrentConnectionAsync();
            if (result != null)
            {
                currentDatabase = result.DatabaseName;
                selectedDatabase = result.DatabaseName;
            }
            else
            {
                currentDatabase = "unknown";
                Logger.LogWarning("Failed to load current database connection");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading current database");
            currentDatabase = "error";
        }
        finally
        {
            isLoadingDatabase = false;
        }
    }

    private async Task OnDatabaseSelectionChanged()
    {
        if (selectedDatabase == currentDatabase)
            return;

        var isProduction = selectedDatabase.Equals("sst", StringComparison.OrdinalIgnoreCase);
        
        var confirmMessage = isProduction
            ? $"⚠️ 警告！\n\n您即將切換到正式環境資料庫 (sst)！\n\n這將影響生產數據，請確認您了解此操作的風險。\n\n確定要繼續嗎？"
            : $"您即將切換到開發測試資料庫 (sstv2)。\n\n應用將會重新啟動。\n\n確定要繼續嗎？";

        var confirmed = await JS.InvokeAsync<bool>("confirm", confirmMessage);
        
        if (!confirmed)
        {
            // 恢復選擇
            selectedDatabase = currentDatabase;
            return;
        }

        isSwitching = true;
        try
        {
            var result = await ApiService.SwitchConnectionAsync(selectedDatabase);
            
            if (result?.Success == true)
            {
                await JS.InvokeVoidAsync("alert", 
                    $"✅ 資料庫已切換到 {selectedDatabase}\n\n" +
                    $"應用將在 1 秒後重新啟動...\n\n" +
                    $"請稍候，頁面會自動重新載入。");
                
                // 等待應用重啟並重新載入頁面
                await Task.Delay(2000);
                await JS.InvokeVoidAsync("location.reload");
            }
            else
            {
                await JS.InvokeVoidAsync("alert", 
                    $"❌ 切換失敗\n\n{result?.Message ?? "Unknown error"}");
                selectedDatabase = currentDatabase;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error switching database");
            await JS.InvokeVoidAsync("alert", 
                $"❌ 切換失敗\n\n{ex.Message}\n\n應用可能已經重新啟動，請手動重新整理頁面。");
            
            // 2秒後嘗試重新載入
            await Task.Delay(2000);
            await JS.InvokeVoidAsync("location.reload");
        }
        finally
        {
            isSwitching = false;
        }
    }

    private string GetDatabaseBannerClass()
    {
        if (string.IsNullOrEmpty(currentDatabase) || currentDatabase == "unknown" || currentDatabase == "error")
            return "database-banner-unknown";

        return currentDatabase.Equals("sst", StringComparison.OrdinalIgnoreCase)
            ? "database-banner-production"
            : "database-banner-development";
    }

    private string GetDatabaseIcon()
    {
        return currentDatabase.Equals("sst", StringComparison.OrdinalIgnoreCase)
            ? "⚠️" : "✅";
    }

    private string GetDatabaseDisplayText()
    {
        if (string.IsNullOrEmpty(currentDatabase))
            return "載入中...";

        return currentDatabase.Equals("sst", StringComparison.OrdinalIgnoreCase)
            ? $"正式環境 (sst) - 請小心操作！"
            : $"開發測試環境 (sstv2)";
    }
}
